#!/bin/bash +x

cat << EOF0 > ${DIRRUN}/static.bash
#!/bin/bash

####PBS -l select=<N_nos>:ncpus=<CPUs_por_no>:mpiprocs=<MPI_por_no>:ompthreads=<OMP_por_no>                                                                                                                                

#PBS -N ${STATIC_jobname}
#PBS -q ${STATIC_QUEUE}
#PBS -l select=${STATIC_nnodes}:ncpus=${STATIC_ncpus}:mpiprocs=${STATIC_ncpn}:ompthreads=${STATIC_nthreads}
#PBS -l walltime=${STATIC_walltime}
#PBS -o ${DATAOUT}/${YYYYMMDDHHi}/Pre/logs/static.bash.o
#PBS -e ${DATAOUT}/${YYYYMMDDHHi}/Pre/logs/static.bash.e
#PBS -l place=scatter:excl
#PBS -V


export executable=init_atmosphere_model

ulimit -s unlimited
ulimit -c unlimited
ulimit -v unlimited

. ${SCRIPTS}/setenv.bash

cd ${DIRRUN}


date
time mpirun --ppn ${STATIC_ncpn} -np ${STATIC_ncores} --depth=${STATIC_nthreads} --cpu-bind depth ./\${executable}
date


grep "Finished running" log.init_atmosphere.0000.out >& /dev/null
if [ \$? -ne 0 ]; then
   echo "  BUMMER: Static generation failed for some yet unknown reason."
   echo " "
   tail -10 ${STATICPATH}/log.init_atmosphere.0000.out
   echo " "
   exit 21
fi

echo "  ####################################"
echo "  ### Static completed - \$(date) ####"
echo "  ####################################"
echo " "


mv log.init_atmosphere.0000.out ${DATAOUT}/logs/log.init_atmosphere.0000.x1.${RES}.static.nc.out


EOF0
