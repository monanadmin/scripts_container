#!/bin/bash

cat > ${DIRRUN}/PostAtmos_node.${node}.sh <<EOSH
#!/bin/bash

####PBS -l select=<N_nos>:ncpus=<CPUs_por_no>:mpiprocs=<MPI_por_no>:ompthreads=<OMP_por_no>

#PBS -N MO.Pos${node}
#PBS -q ${POST_QUEUE}
#PBS -l select=${POST_nnodes}:ncpus=${POST_ncpus}:mpiprocs=${POST_ncpn}:ompthreads=${POST_nthreads}
#PBS -l walltime=${POST_walltime}
#PBS -o ${DATAOUT}/${YYYYMMDDHHi}/Post/logs/PostAtmos_node.${node}.o
#PBS -e ${DATAOUT}/${YYYYMMDDHHi}/Post/logs/PostAtmos_node.${node}.e
#PBS -l place=scatter:excl
#PBS -V


cd ${DIRRUN}
. ${SCRIPTS}/setenv.bash

#echo "-- SLURM_JOB_ID: \$SLURM_JOB_ID"
echo "-- PBS_JOBID: \$PBS_JOBID"

chmod 755 ${DIRRUN}/*

echo "Submiting posts ${inicio} to ${fim} in node Node ${node}."

for ii in \$(seq  ${inicio} ${fim})
do
   i=\$(printf "%04d" \${ii})
   echo "Preparing post files \${i}"
   cp -f ${DATAOUT}/${YYYYMMDDHHi}/Pre/x1.${RES}.init.nc ${DIRRUN}/dir.\${i} &
   cp -f ${EXECS}/convert_mpas ${DIRRUN}/dir.\${i} &
done

wait

for ii in \$(seq  ${inicio} ${fim})
do
   i=\$(printf "%04d" \${ii})
   echo "Executing post \${i}"
   cd ${DIRRUN}/dir.\${i}

   hh=${YYYYMMDDHHi:8:2}
   currentdate=\$(date -d "${YYYYMMDDHHi:0:8} \${hh}:00:00 \$(echo "(\${i}-1)*${t_strout:0:2}" | ${BC}) hours \$(echo "(\${i}-1)*${t_strout:3:2}" | ${BC}) minutes \$(echo "(\${i}-1)*${t_strout:6:2}" | ${BC}) seconds" +"%Y%m%d%H.%M.%S")
   diag_name=MONAN_DIAG_${MODERUN}_MOD_${EXP}_${YYYYMMDDHHi}_\${currentdate}.x${RES}L${N_MODEL_LEV}.nc

   time ./convert_mpas x1.${RES}.init.nc ${DATAOUT}/${YYYYMMDDHHi}/Model/\${diag_name}  >> convert_mpas.output &
   echo "./convert_mpas x1.${RES}.init.nc ${DATAOUT}/${YYYYMMDDHHi}/Model/\${diag_name} >> convert_mpas.output"
done

# necessario aguardar as rodadas em background
wait

for ii in \$(seq  ${inicio} ${fim})
do
   i=\$(printf "%04d" \${ii})
   hh=${YYYYMMDDHHi:8:2}
   currentdate=\$(date -d "${YYYYMMDDHHi:0:8} \${hh}:00 \$(echo "(\${i}-1)*3" | ${BC}) hours" +"%Y%m%d%H")
   diag_name_post=MONAN_DIAG_${MODERUN}_POS_${EXP}_${YYYYMMDDHHi}_\${currentdate}.00.00.x${RES}L${N_MODEL_LEV}.nc

   cd ${DIRRUN}/dir.\${i}
   cp latlon.nc  ${DATAOUT}/${YYYYMMDDHHi}/Post/\${diag_name_post} >> convert_mpas.output &
   echo "cp latlon.nc  ${DATAOUT}/${YYYYMMDDHHi}/Post/\${diag_name_post}"  >> convert_mpas.output

done

wait

EOSH
