mv ${DATAOUT}/${YYYYMMDDHHi}/Pre/logs/static.bash.o ${DATAOUT}/${YYYYMMDDHHi}/Pre/logs/static.bash.o.${JOBID}
mv ${DATAOUT}/${YYYYMMDDHHi}/Pre/logs/static.bash.e ${DATAOUT}/${YYYYMMDDHHi}/Pre/logs/static.bash.e.${JOBID}

