#!/bin/bash

cat << EOF0 > ${DIRRUN}/initatmos.bash 
#!/bin/bash
#PBS -N ${INITATMOS_jobname}
#PBS -q ${INITATMOS_QUEUE}
#PBS -l select=${INITATMOS_nnodes}:ncpus=${INITATMOS_ncpus}:mpiprocs=${INITATMOS_ncpn}:ompthreads=${INITATMOS_nthreads}
#PBS -l walltime=${INITATMOS_walltime}
#PBS -o ${DATAOUT}/${YYYYMMDDHHi}/Pre/logs/initatmos.bash.o
#PBS -e ${DATAOUT}/${YYYYMMDDHHi}/Pre/logs/initatmos.bash.e
#PBS -l place=scatter:excl
#PBS -V


export executable=init_atmosphere_model

ulimit -c unlimited
ulimit -v unlimited
ulimit -s unlimited


. ${SCRIPTS}/setenv.bash

cd ${DIRRUN}


export CURRENT_HOST=\$(cat \$PBS_NODEFILE)
export HOSTFILE=${DIRRUN}/hostfile
echo "\${CURRENT_HOST}" | sed "s,\..*$,," > \${HOSTFILE}

date
time singularity --quiet exec --bind ${SCRIPTS}/.. --bind /home ${SINGULARITY} bash -c "
   export OMP_NUM_THREADS=${INITATMOS_nthreads}
   time mpirun --hostfile \${HOSTFILE} --ppn ${INITATMOS_ncpn} -np ${INITATMOS_ncores} -bind-to core:${INITATMOS_nthreads} -map-by core ./\${executable}
"
date


mv ${DIRRUN}/log.init_atmosphere.0000.out ${DATAOUT}/${YYYYMMDDHHi}/Pre/logs/log.init_atmosphere.0000.x1.${RES}.init.nc.${YYYYMMDDHHi}.out
mv ${DIRRUN}/namelist.init_atmosphere ${DATAOUT}/${YYYYMMDDHHi}/Pre/logs
mv ${DIRRUN}/streams.init_atmosphere ${DATAOUT}/${YYYYMMDDHHi}/Pre/logs
mv ${DIRRUN}/x1.${RES}.init.nc ${DATAOUT}/${YYYYMMDDHHi}/Pre

EOF0
